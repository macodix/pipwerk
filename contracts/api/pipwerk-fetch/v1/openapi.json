            "title": "Version",
            "default": 1
          },
          "kind": {
            "type": "string",
            "const": "ticks",
            "title": "Kind",
            "default": "ticks"
          },
          "broker": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$",
            "title": "Broker"
          },
          "instrument": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$",
            "title": "Instrument"
          },
          "period": {
            "$ref": "#/components/schemas/PeriodDocument"
          },
          "trading_hours": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TradingSessionDocument"
                },
                "type": "array"
              },
