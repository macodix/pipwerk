                "type": "null"
              }
            ],
            "title": "Trading Hours"
          },
          "ticks": {
            "items": {
              "$ref": "#/components/schemas/TickEntry"
            },
            "type": "array",
            "title": "Ticks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "broker",
          "instrument",
          "period",
          "trading_hours",
          "ticks"
        ],
        "title": "TickSeriesDocument",
        "description": "The ticks of one series: broker and instrument."
      },
      "TickSeriesResponse": {
        "properties": {
          "file": {
            "$ref": "#/components/schemas/TickSeriesDocument"
          },
          "omitted_count": {
            "type": "integer",
            "title": "Omitted Count"
          },
          "omitted": {
            "items": {
              "$ref": "#/components/schemas/OmittedRow"
            },
            "type": "array",
            "title": "Omitted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file",
          "omitted_count",
          "omitted"
        ],
        "title": "TickSeriesResponse"
      },
      "TicksRequest": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start",
            "description": "Start of the period, included."
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End",
            "description": "End of the period, excluded."
          },
          "kind": {
            "type": "string",
            "const": "ticks",
            "title": "Kind"
          },
          "instrument": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$",
            "title": "Instrument"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "kind",
          "instrument"
        ],
        "title": "TicksRequest",
        "description": "Ticks with milliseconds."
      },
      "TradingSessionDocument": {
        "properties": {
