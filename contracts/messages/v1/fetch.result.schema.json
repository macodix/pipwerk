{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FailedPart": {
      "additionalProperties": false,
      "description": "A part that could not be fetched: the kind of data, the period and the reason.",
      "properties": {
        "data": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5",
            "M6",
            "M10",
            "M12",
            "M15",
            "M20",
            "M30",
            "H1",
            "H2",
            "H3",
            "H4",
            "H6",
            "H8",
            "H12",
            "D1",
            "W1",
            "MN1",
            "TICKS",
            "CONTRACT"
          ],
          "title": "Data",
          "type": "string"
        },
        "from": {
          "examples": [
            "2026-01-05T00:00:00Z"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "From",
          "type": "string"
        },
        "to": {
          "examples": [
            "2026-01-05T00:00:00Z"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "To",
          "type": "string"
        },
        "code": {
          "enum": [
            "symbol_unknown",
            "no_data",
            "range_too_large",
            "terminal_unavailable",
            "broker_error",
            "broker_unknown",
            "invalid_broker_data",
            "write_failed",
            "internal_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data",
        "from",
        "to",
        "code",
        "text"
      ],
      "title": "FailedPart",
      "type": "object"
    },
    "RequestError": {
      "additionalProperties": false,
      "description": "Why the request as a whole was not carried out.",
      "properties": {
        "code": {
          "enum": [
            "request_invalid",
            "broker_mismatch",
            "terminal_unavailable",
            "broker_unknown",
            "internal_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "code",
        "text"
      ],
      "title": "RequestError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Content of ``fetch.result``: the end of an answer.",
  "properties": {
    "files": {
      "items": {
        "examples": [
          "EURUSD_H1_20260105_20260106.json"
        ],
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._#+-]{0,63}_[A-Z][A-Z0-9]{1,7}_[0-9]{8}(?:T[0-9]{6})?_[0-9]{8}(?:T[0-9]{6})?\\.json$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Files",
      "type": "array"
    },
    "failed": {
      "items": {
        "$ref": "#/$defs/FailedPart"
      },
      "maxItems": 64,
      "title": "Failed",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RequestError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "files",
    "failed"
  ],
  "title": "FetchResultContent",
  "type": "object"
}
