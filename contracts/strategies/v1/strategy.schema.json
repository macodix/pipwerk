{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BindingDocument": {
      "additionalProperties": false,
      "description": "Value of a parameter or property with its kind of binding.",
      "properties": {
        "kind": {
          "enum": [
            "fixed",
            "parameter",
            "expression",
            "application"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BindingDocument",
      "type": "object"
    },
    "ConnectionDocument": {
      "additionalProperties": false,
      "description": "A connection from an output of an element to an element.",
      "properties": {
        "source": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Source",
          "type": "string"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "target": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "output",
        "target"
      ],
      "title": "ConnectionDocument",
      "type": "object"
    },
    "ElementDocument": {
      "additionalProperties": false,
      "description": "An element on the drawing area. The type is a text; an unknown type is valid and\nits values are kept.",
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/BindingDocument"
          },
          "title": "Parameters",
          "type": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/BindingDocument"
          },
          "title": "Properties"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/InstanceDocument"
          },
          "maxItems": 200,
          "title": "Rules",
          "type": "array"
        },
        "management_of": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Management Of"
        },
        "instance": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstanceDocument"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "ElementDocument",
      "type": "object"
    },
    "InstanceDocument": {
      "additionalProperties": false,
      "description": "A complete copy of a template or object type (E4). The base classes are in this\norder so that name, object type and origin come before the content.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "object_type": {
          "title": "Object Type",
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/OriginDocument"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parameter_values": {
          "additionalProperties": {
            "$ref": "#/$defs/BindingDocument"
          },
          "title": "Parameter Values",
          "type": "object"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterDefinitionDocument"
          },
          "title": "Parameters",
          "type": "array"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertyDefinitionDocument"
          },
          "title": "Properties"
        },
        "instances": {
          "items": {
            "$ref": "#/$defs/InstanceDocument"
          },
          "title": "Instances",
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/InstanceDocument"
          },
          "maxItems": 200,
          "title": "Rules",
          "type": "array"
        },
        "expression": {
          "anyOf": [
            {
              "description": "Expression in OpenFormula notation",
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "determined_property": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Determined Property"
        },
        "comparison": {
          "anyOf": [
            {
              "enum": [
                "hoechstens",
                "mindestens",
                "gleich"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison"
        },
        "result_expression": {
          "anyOf": [
            {
              "description": "Expression in OpenFormula notation",
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Expression"
        }
      },
      "required": [
        "name",
        "object_type"
      ],
      "title": "InstanceDocument",
      "type": "object"
    },
    "OriginDocument": {
      "additionalProperties": false,
      "description": "Origin of an instance: object type and, if known, identifier and title of the template.",
      "properties": {
        "object_type": {
          "title": "Object Type",
          "type": "string"
        },
        "template_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Id"
        },
        "template_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Title"
        }
      },
      "required": [
        "object_type"
      ],
      "title": "OriginDocument",
      "type": "object"
    },
    "ParameterDefinitionDocument": {
      "additionalProperties": false,
      "description": "Own parameter of a template or instance.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "datatype": {
          "enum": [
            "number",
            "integer",
            "percent",
            "boolean",
            "text",
            "choice",
            "time_unit",
            "timestamp",
            "date",
            "expression",
            "object"
          ],
          "title": "Datatype",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "datatype"
      ],
      "title": "ParameterDefinitionDocument",
      "type": "object"
    },
    "PropertyDefinitionDocument": {
      "additionalProperties": false,
      "description": "Own property of an indicator or trend with its expression.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "datatype": {
          "enum": [
            "number",
            "integer",
            "percent",
            "boolean",
            "text",
            "choice",
            "time_unit",
            "timestamp",
            "date",
            "expression",
            "object"
          ],
          "title": "Datatype",
          "type": "string"
        },
        "expression": {
          "description": "Expression in OpenFormula notation",
          "maxLength": 4096,
          "title": "Expression",
          "type": "string"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "datatype",
        "expression"
      ],
      "title": "PropertyDefinitionDocument",
      "type": "object"
    },
    "StrategyParameterDocument": {
      "additionalProperties": false,
      "description": "Parameter of a strategy: a value or \"at the application\".",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "datatype": {
          "enum": [
            "number",
            "integer",
            "percent",
            "boolean",
            "text",
            "choice",
            "time_unit",
            "timestamp",
            "date",
            "expression",
            "object"
          ],
          "title": "Datatype",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "at_application": {
          "default": false,
          "title": "At Application",
          "type": "boolean"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "datatype"
      ],
      "title": "StrategyParameterDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Document of a strategy (format ``pipwerk.strategy``).",
  "properties": {
    "format_version": {
      "description": "Version of the format; a document of a higher major version is rejected",
      "pattern": "^1\\.[0-9]+$",
      "title": "Format Version",
      "type": "string"
    },
    "format": {
      "const": "pipwerk.strategy",
      "title": "Format",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/StrategyParameterDocument"
      },
      "maxItems": 200,
      "title": "Parameters",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/InstanceDocument"
      },
      "maxItems": 200,
      "title": "Rules",
      "type": "array"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/ElementDocument"
      },
      "maxItems": 1000,
      "title": "Elements",
      "type": "array"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/ConnectionDocument"
      },
      "maxItems": 4000,
      "title": "Connections",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "format",
    "id",
    "title"
  ],
  "title": "StrategyDocument",
  "type": "object"
}
