  "rules": [
    {
      "name": "risiko",
      "object_type": "Regel",
      "origin": {
        "object_type": "Regel",
        "template_id": "7c1d4e2a-5b3f-4a86-9d27-e1f0a3c8b645",
        "template_title": "Risiko je Trade"
      },
      "parameter_values": {
        "risikogrenze": {
          "kind": "fixed",
          "value": 0.01
        }
      },
      "parameters": [
        {
          "name": "risikogrenze",
          "datatype": "percent",
          "required": true,
          "default": 0.01,
          "choices": []
        }
      ],
      "properties": [],
      "instances": [],
      "rules": [],
      "expression": "IF(ISNA(Position.volumen);\n   IF(IF(Order.richtung = \"buy\"; IFNA(Order.limitpreis; Order.preis) - Order.stop_loss; Order.stop_loss - IFNA(Order.limitpreis; Order.preis)) <= 0;\n      Order.volumen;\n      FLOOR(risikogrenze * Konto.kapital\n              / (IF(Order.richtung = \"buy\"; IFNA(Order.limitpreis; Order.preis) - Order.stop_loss; Order.stop_loss - IFNA(Order.limitpreis; Order.preis)) / Instrument.tickgroesse * Instrument.tickwert);\n            Instrument.volumenschritt));\n   IF(IF(Position.richtung = \"buy\"; Position.einstiegspreis - Position.stop_loss; Position.stop_loss - Position.einstiegspreis) <= 0;\n      Position.volumen;\n      FLOOR(risikogrenze * Konto.kapital\n              / (IF(Position.richtung = \"buy\"; Position.einstiegspreis - Position.stop_loss; Position.stop_loss - Position.einstiegspreis) / Instrument.tickgroesse * Instrument.tickwert);\n            Instrument.volumenschritt)))",
      "determined_property": "volumen",
      "comparison": "hoechstens",
      "result_expression": null
    }
  ],
