      "parameters": [
        {
          "key": "risikogrenze",
          "name": "Risikogrenze",
          "datatype": "percent",
          "object_type": null,
          "required": true,
          "default": 0.01,
          "choices": []
        }
      ],
      "properties": [],
      "instances": [],
      "rules": [],
      "expression": "IF(ISNA(Position.volumen);\n   IF(IF(Order.richtung = \"buy\"; IFNA(Order.limitpreis; Order.preis) - Order.stop_loss; Order.stop_loss - IFNA(Order.limitpreis; Order.preis)) <= 0;\n      Order.volumen;\n      FLOOR(risikogrenze * Konto.kapital\n              / (IF(Order.richtung = \"buy\"; IFNA(Order.limitpreis; Order.preis) - Order.stop_loss; Order.stop_loss - IFNA(Order.limitpreis; Order.preis)) / Order.instrument.tickgroesse * Order.instrument.tickwert);\n            Order.instrument.volumenschritt));\n   IF(IF(Position.richtung = \"buy\"; Position.einstiegspreis - Position.stop_loss; Position.stop_loss - Position.einstiegspreis) <= 0;\n      Position.volumen;\n      FLOOR(risikogrenze * Konto.kapital\n              / (IF(Position.richtung = \"buy\"; Position.einstiegspreis - Position.stop_loss; Position.stop_loss - Position.einstiegspreis) / Order.instrument.tickgroesse * Order.instrument.tickwert);\n            Order.instrument.volumenschritt)))",
      "determined_property": "volumen",
      "comparison": "hoechstens",
      "result_expression": null
    }
  ],
