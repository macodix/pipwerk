#!/bin/sh
# Check script of the component pipwerk Studio.
#
# Runs the automatic checks of the component on the working directory this
# script belongs to and ends with exit code 0 only if all of them pass:
#
#   check --backend-port <port> --frontend-port <port> [--with-audit]
#
# Checks: the shared Python library in packages/domain-core (uv sync --frozen,
# pytest, ruff check, ruff format --check, mypy, comparison of the generated
# JSON schemas with contracts/strategies/v2 and v1), backend (uv sync --frozen,
# pytest, ruff check, ruff format --check, mypy), search in the repository for
# the spelling of the name, frontend (npm ci, typecheck, Vitest, build) and the
# browser test with Playwright on the given ports. --with-audit adds pip-audit
# for the library and the backend and npm audit.
#
# The working directory is derived from the path of this script. The script
# can be called from any directory. Ports are parameters; the script contains
# no fixed ports, paths or machine names.
#
# This file may contain wrong spellings of the name as check values; it is
# excluded from the search in the repository.
#
# Documentation: docs/technical/pipwerk-studio.md, section 6.4 "Prüfskript";
# checks of the library: docs/technical/pipwerk-domain.md, section 12.

set -u

# A Git environment inherited from the caller must not redirect the search.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

PROG=check

die() {
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 2
}

usage() {
    cat >&2 <<EOF
Usage:
  $PROG --backend-port <port> --frontend-port <port> [--with-audit]
EOF
    exit 2
}

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P) ||
    die "cannot determine the directory of the script"
component_dir=$(CDPATH='' cd -- "$script_dir/.." && pwd -P) ||
    die "cannot determine the directory of the component"
backend_dir="$component_dir/backend"
frontend_dir="$component_dir/frontend"
# The shared Python library and the contracts lie two levels above the
# component, in the same working directory.
library_dir=$(CDPATH='' cd -- "$component_dir/../../packages/domain-core" && pwd -P) ||
    die "cannot determine the directory of the library packages/domain-core"
schemas_dir=$(CDPATH='' cd -- "$component_dir/../../contracts/strategies" && pwd -P) ||
    die "cannot determine the directory of the schemas contracts/strategies"

# require_port <parameter> <value>: sets PORT_VALUE to the value without
# leading zeros. The length check keeps numbers out of the shell's integer
# arithmetic that it cannot handle.
require_port() {
    PORT_VALUE=$2
    case $PORT_VALUE in
    '' | *[!0-9]*) die "$1 must be a number between 1 and 65535" ;;
    esac
    while [ "${PORT_VALUE#0}" != "$PORT_VALUE" ]; do
        PORT_VALUE=${PORT_VALUE#0}
    done
    case $PORT_VALUE in
    '' | ??????*) die "$1 must be a number between 1 and 65535" ;;
    esac
    if [ "$PORT_VALUE" -gt 65535 ]; then
        die "$1 must be a number between 1 and 65535"
    fi
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required program not found: $1"
}

backend_port=''
frontend_port=''
with_audit=0
while [ $# -gt 0 ]; do
    case $1 in
    --backend-port | --frontend-port)
        [ $# -ge 2 ] || die "missing value for $1"
        case $1 in
        --backend-port) backend_port=$2 ;;
        --frontend-port) frontend_port=$2 ;;
        esac
        shift 2
        ;;
    --with-audit)
        with_audit=1
        shift
        ;;
    -h | --help) usage ;;
    *) die "unknown parameter: $1" ;;
    esac
done
[ -n "$backend_port" ] || die "missing parameter --backend-port"
[ -n "$frontend_port" ] || die "missing parameter --frontend-port"
require_port --backend-port "$backend_port"
backend_port=$PORT_VALUE
require_port --frontend-port "$frontend_port"
frontend_port=$PORT_VALUE
[ "$backend_port" != "$frontend_port" ] ||
    die "--backend-port and --frontend-port must differ"

require_command git
require_command uv
require_command npm
require_command npx

repo_root=$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null) ||
    die "$script_dir is not in a Git working directory"

passed=''
failed=''

# step <name> <command...>: runs one check and records the result.
step() {
    step_name=$1
    shift
    printf '\n%s: === %s ===\n' "$PROG" "$step_name"
    if "$@"; then
        printf '%s: passed: %s\n' "$PROG" "$step_name"
        passed="$passed
  $step_name"
    else
        printf '%s: FAILED: %s\n' "$PROG" "$step_name" >&2
        failed="$failed
  $step_name"
    fi
}

in_library() {
    uv --directory "$library_dir" "$@"
}

in_backend() {
    uv --directory "$backend_dir" "$@"
}

in_frontend() {
    (cd "$frontend_dir" && "$@")
}

# search_name: every spelling of the name with a space or hyphen between the
# two words, in any case, in all versioned files outside of docs/design/ and
# development/ and outside of the two files that may contain wrong spellings
# as check values, is exactly "pipwerk Studio" or the identifier
# "pipwerk-studio".
search_name() {
    search_output=$(git -C "$repo_root" grep -n -o -I -i -E 'pipwerk[ -]studio' -- . \
        ':!docs/design' ':!development' \
        ':!components/pipwerk-studio/backend/tests/test_name.py' \
        ':!components/pipwerk-studio/scripts/check')
    search_status=$?
    # git grep ends with 1 if nothing is found; that is not an error.
    if [ "$search_status" -gt 1 ]; then
        printf '%s: git grep failed with exit code %s\n' "$PROG" "$search_status" >&2
        return 1
    fi
    search_wrong=$(printf '%s\n' "$search_output" |
        grep -v -E ':(pipwerk Studio|pipwerk-studio)$' | grep -v '^$')
    search_count=$(printf '%s\n' "$search_output" | grep -c -v '^$')
    if [ -n "$search_wrong" ]; then
        printf '%s: wrong spellings of the name:\n%s\n' "$PROG" "$search_wrong" >&2
        return 1
    fi
    printf '%s: %s mentions checked, all spelled correctly\n' "$PROG" "$search_count"
}

# pip_audit <in_library|in_backend> [<option of uv export>...]: checks the
# packages locked in uv.lock of that directory for known vulnerabilities. The
# further options go to uv export; the backend leaves out the library of the
# repository with --no-emit-package pipwerk-domain (section 6.1): it is a path
# dependency, not a published package, and is checked with its own uv.lock.
pip_audit() {
    audit_in=$1
    shift
    audit_requirements=$(mktemp) || return 1
    audit_status=0
    "$audit_in" export --frozen --no-hashes --no-emit-project "$@" -o "$audit_requirements" &&
        uvx pip-audit -r "$audit_requirements" --no-deps --disable-pip || audit_status=1
    rm -f "$audit_requirements"
    return "$audit_status"
}

browser_test() {
    (
        cd "$frontend_dir" &&
            PIPWERK_STUDIO_E2E_BACKEND_PORT=$backend_port \
                PIPWERK_STUDIO_E2E_FRONTEND_PORT=$frontend_port \
                npm run e2e
    )
}

printf '%s: checking %s at commit %s\n' "$PROG" "$repo_root" \
    "$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf 'unknown')"

# Shared Python library (docs/technical/pipwerk-domain.md, section 12)
step "library: uv sync --frozen" in_library sync --frozen
step "library: pytest" in_library run --frozen pytest
step "library: ruff check" in_library run --frozen ruff check
step "library: ruff format --check" in_library run --frozen ruff format --check
step "library: mypy" in_library run --frozen mypy
step "library: schemas equal to contracts/strategies/v2" in_library run --frozen \
    python -m pipwerk_domain.documents.schemas --check "$schemas_dir/v2"
step "library: schemas equal to contracts/strategies/v1" in_library run --frozen \
    python -m pipwerk_domain.documents.schemas --check --format-version 1 "$schemas_dir/v1"
if [ "$with_audit" = 1 ]; then
    step "library: pip-audit" pip_audit in_library
fi

# Backend (technical documentation, section 6.1)
step "backend: uv sync --frozen" in_backend sync --frozen
step "backend: pytest" in_backend run --frozen pytest
step "backend: ruff check" in_backend run --frozen ruff check
step "backend: ruff format --check" in_backend run --frozen ruff format --check
step "backend: mypy" in_backend run --frozen mypy
step "search in the repository for the spelling of the name" search_name
if [ "$with_audit" = 1 ]; then
    step "backend: pip-audit" pip_audit in_backend --no-emit-package pipwerk-domain
fi

# Frontend (section 6.2)
step "frontend: npm ci" in_frontend npm ci
step "frontend: typecheck" in_frontend npm run typecheck
step "frontend: Vitest" in_frontend npm test
step "frontend: build" in_frontend npm run build
if [ "$with_audit" = 1 ]; then
    step "frontend: npm audit" in_frontend npm audit
fi

# Browser test (section 6.3)
step "browser test (Chromium, Firefox, WebKit)" browser_test

printf '\n%s: passed:%s\n' "$PROG" "${passed:-
  none}"
if [ -n "$failed" ]; then
    printf '%s: failed:%s\n' "$PROG" "$failed" >&2
    exit 1
fi
printf '%s: all checks passed\n' "$PROG"
