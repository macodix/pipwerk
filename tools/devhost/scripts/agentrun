#!/usr/bin/env bash
# agentrun – startet und überwacht die Sitzungen von Softwarearchitekt und Entwicklungsleiter.
# Grundlage: docs/technical/entwicklungsverfahren.md, Abschnitte „Meldungen“, „agentrun“ und „Herzschlag“.
# Aufruf: agentrun, gestartet von pidcheck. Beenden: kill "$(cat run/agentrun.pid)".

# Parameter: die Umgebung überschreibt die Standardwerte (so setzt die Testumgebung sie).
# Die Installation setzt GITHUB_REPO und CLAUDE auf die Werte des Entwicklungsrechners (siehe README).
ROOT="$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)"    # Entwicklungsverzeichnis: das Verzeichnis über scripts/, in dem dieses Skript liegt
HEARTBEAT_TIMEOUT="${HEARTBEAT_TIMEOUT:-900}"    # Sekunden ohne Herzschlag bis zum Abbruch
INTERVAL="${INTERVAL:-30}"                       # Sekunden, nach denen inotifywait spätestens zurückkehrt
GITHUB_REPO="${GITHUB_REPO:-}"                   # Repository für Meldungen failed, <Eigentümer>/<Name>; die Installation setzt es
CLAUDE="${CLAUDE:-claude}"                       # Programm der Sitzung; die Installation setzt den vollständigen Pfad
ABORT_LIMIT="${ABORT_LIMIT:-3}"                  # Abbrüche derselben Meldung, bei denen nicht mehr fortgesetzt wird, sondern failed folgt
RESUME_GRACE="${RESUME_GRACE:-60}"               # Endet eine fortgesetzte Sitzung innerhalb dieser Sekunden, gilt die Fortsetzung als nicht möglich
PAUSE_INTERVAL="${PAUSE_INTERVAL:-900}"          # Sekunden zwischen den Prüfungen der Nutzungsgrenze, wenn die Meldung keinen Zeitpunkt nennt

# Nutzungsgrenze: Suchtext im sichtbaren Inhalt der tmux-Sitzung und Muster des Zeitpunkts in der Zeile mit dem Suchtext
# (erweiterter regulärer Ausdruck, das Ergebnis muss von „date -d“ gelesen werden).
# Beide Werte sind Platzhalter: der Wortlaut der echten Ausgabe von Claude Code ist ungeprüft (Spezifikation 3.3 Punkt 5).
LIMIT_TEXT="${LIMIT_TEXT:-Platzhalter: Nutzungsgrenze erreicht}"
LIMIT_TIME_PATTERN="${LIMIT_TIME_PATTERN:-}"
if [[ -z "$LIMIT_TIME_PATTERN" ]]; then
  LIMIT_TIME_PATTERN='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z'   # Platzhalter: ISO-8601-Zeitpunkt in UTC
fi

RESUME_PROMPT="Die Sitzung wurde abgebrochen. Prüfe den Stand deines Arbeitsverzeichnisses und setze die Aufgabe dort fort, wo sie abgebrochen ist."
CONTINUE_PROMPT="Die Nutzungsgrenze ist aufgehoben. Fahre fort."

MESSAGES_PATH=development/messages               # Meldungen, je Empfänger ein Verzeichnis
OUTBOX_PATH=$MESSAGES_PATH/projectlead           # Meldungen an den Projektleiter
ROLES=(architect devlead)                        # überwachte Empfänger, zugleich Rollennamen der Arbeitsverzeichnisse
declare -A AGENT=([architect]=software-architect [devlead]=devlead)   # Agentendefinition je Rolle
declare -A OTHER=([architect]=devlead [devlead]=architect)            # Verzeichnis der jeweils anderen Rolle
MESSAGES="$ROOT/repo/$MESSAGES_PATH"
OUTBOX="$ROOT/repo/$OUTBOX_PATH"
RUN="$ROOT/run"
WORK="$ROOT/work"
DEVTEAM="$ROOT/devteam"
STARTED="$RUN/agentrun.started"                  # Meldungen, die eine Sitzung gestartet haben, eine je Zeile

shopt -s nullglob

log() {
  echo "$(date +%Y-%m-%dT%H:%M:%S) $*" >&2
}

# Wert eines Felds aus einer Zeile „- name: `wert`“: field DATEI NAME
field() {
  sed -n "s/^- $2: \`\(.*\)\`\$/\1/p" "$1" | head -n 1
}

# ref ist <vorhaben> oder <vorhaben>/<arbeitspaket>
valid_ref() {
  [[ "$1" =~ ^[a-z0-9]+(/wp[0-9][0-9])?$ ]]
}

# Name der tmux-Sitzung und der Dateien in run/: ref mit „-“ statt „/“
key_of() {
  echo "${1//\//-}"
}

# ---------------------------------------------------------------- Meldung failed

# Meldung failed für später vormerken: queue_failed MELDUNG REF ROLLE GRUND
queue_failed() {
  printf '%s\n%s\n%s\n' "$2" "$MESSAGES_PATH/$3/$1" "$4" >"$RUN/$1.failed"
}

# Meldung failed über die GitHub-API direkt auf main anlegen: send_failed MELDUNG REF DOKUMENT GRUND
send_failed() {
  local msg="$1" ref="$2" document="$3" reason="$4"
  local name content
  name="$(date -u +%Y%m%d%H%M%S)-agentrun-01.md"
  content="$(printf '# Meldung\n\n- from: `agentrun`\n- ref: `%s`\n- task: `failed`\n- document: `%s`\n\n%s\n' \
    "$ref" "$document" "$reason" | base64 -w0)"
  if gh api -X PUT "repos/$GITHUB_REPO/contents/$OUTBOX_PATH/$name" \
       -f message="development: Meldung failed für $ref" -f content="$content" -f branch=main >/dev/null; then
    log "$msg: Meldung failed als $OUTBOX_PATH/$name geschrieben"
    return 0
  fi
  log "$msg: Meldung failed ließ sich nicht schreiben, neuer Versuch bei der nächsten Prüfung"
  return 1
}

# Vorgemerkte Meldungen failed senden; run/<meldung>.failed: Zeile 1 ref, Zeile 2 Pfad der Meldung, danach Grund
send_pending() {
  local f msg ref document reason
  for f in "$RUN"/*.failed; do
    msg="$(basename "$f" .failed)"
    ref="$(sed -n 1p "$f")"
    document="$(sed -n 2p "$f")"
    reason="$(tail -n +3 "$f")"
    if send_failed "$msg" "$ref" "$document" "$reason"; then
      rm "$f"
    fi
  done
}

# ---------------------------------------------------------------- Sitzungen
# Zustand einer Sitzung: run/<key>.session, eine Angabe je Zeile:
#   1 Meldung, 2 ref, 3 Beginn der Herzschlagmessung (Start oder Fortsetzung), 4 Rolle,
#   5 Kennung der Claude-Sitzung (--session-id), 6 Zahl der Abbrüche dieser Meldung,
#   7 Zeitpunkt der letzten Fortsetzung mit --resume (0: nicht fortgesetzt oder neu gestartet).
# Die Datei gehört zur Meldung und wird mit ihr gelöscht; der Zähler beginnt damit bei jeder Meldung neu.
# run/<key>.known mit den Meldungen in projectlead/ und im Verzeichnis der anderen Rolle beim Start.
# run/<key>.paused: Sitzung ist wegen der Nutzungsgrenze pausiert; Zeile 1 Zeitpunkt der nächsten Prüfung
#   (Sekunden seit 1970), Zeile 2 der in der Meldung genannte Zeitpunkt (kann leer sein).
# run/<key>.screen: Bildschirminhalt beim Beenden, bleibt liegen bis zum nächsten Beenden.

# Zeile N einer Zustandsdatei ersetzen (Werte ohne Sonderzeichen): set_line DATEI N WERT
set_line() {
  sed -i "$2s/.*/$3/" "$1"
}

new_id() {
  cat /proc/sys/kernel/random/uuid
}

# Startauftrag einer Meldung: start_prompt MELDUNG ROLLE
start_prompt() {
  echo "Bearbeite die Meldung $MESSAGES/$2/$1. Entwicklungsverzeichnis: $ROOT."
}

# Sitzung in tmux starten, Meldungen von tmux auf der Standardausgabe:
# launch KEY VERZEICHNIS ROLLE --session-id|--resume KENNUNG STARTAUFTRAG
# 8>&- : ein hier gestarteter tmux-Server erbt die Sperre von agentrun nicht
launch() {
  local key="$1" dir="$2" role="$3"
  shift 3
  tmux new-session -d -s "$key" -c "$dir" \
    "$CLAUDE" --setting-sources project --permission-mode dontAsk \
      --plugin-dir "$DEVTEAM" --settings "$DEVTEAM/settings.json" \
      --agent "devteam:${AGENT[$role]}" \
      "$1" "$2" "$3" 2>&1 8>&-
}

# Meldungen in projectlead/ und im Verzeichnis der anderen Rolle, je Zeile <verzeichnis>/<datei>: answer_candidates ROLLE
answer_candidates() {
  local f
  for f in "$OUTBOX"/*.md "$MESSAGES/${OTHER[$1]}"/*.md; do
    echo "${f#"$MESSAGES/"}"
  done
}

start_session() {
  local msg="$1" ref="$2" role="$3"
  local key dir out id
  key="$(key_of "$ref")"
  dir="$WORK/$ref/$role"
  mkdir -p "$dir"
  answer_candidates "$role" >"$RUN/$key.known"
  echo "$msg" >>"$STARTED"
  id="$(new_id)"
  if ! out="$(launch "$key" "$dir" "$role" --session-id "$id" "$(start_prompt "$msg" "$role")")"; then
    rm "$RUN/$key.known"
    queue_failed "$msg" "$ref" "$role" "Die Sitzung ließ sich nicht starten: $out"
    log "$ref: Start fehlgeschlagen: $out"
    return
  fi
  printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' "$msg" "$ref" "$(date +%s)" "$role" "$id" 0 0 >"$RUN/$key.session"
  log "$ref: Sitzung $key ($role, Kennung $id) gestartet für $msg"
}

# Leeres Verzeichnis entfernen, fehlendes oder volles stehen lassen
remove_if_empty() {
  if [[ -d "$1" && -z "$(ls -A "$1")" ]]; then
    rmdir "$1"
  fi
}

# Sitzung beenden; mit Grund wird eine Meldung failed vorgemerkt: end_session KEY [GRUND]
end_session() {
  local key="$1" reason="$2"
  local msg ref role
  msg="$(sed -n 1p "$RUN/$key.session")"
  ref="$(sed -n 2p "$RUN/$key.session")"
  role="$(sed -n 4p "$RUN/$key.session")"
  tmux capture-pane -p -t "$key" -S -200 > "$ROOT/run/$key.screen" 2>&1
  tmux kill-session -t "=$key" 2>/dev/null
  if [[ -n "$reason" ]]; then
    queue_failed "$msg" "$ref" "$role" "$reason"
    log "$ref: Sitzung beendet: $reason"
  else
    log "$ref: Sitzung nach Antwortmeldung beendet"
  fi
  rm -f "$RUN/$key.session" "$RUN/$key.known" "$RUN/$key.heartbeat" "$RUN/$key.paused"
  remove_if_empty "$WORK/$ref/$role"
  remove_if_empty "$WORK/$ref"
  remove_if_empty "$WORK/${ref%/*}"
}

# Sitzung mit dem ursprünglichen Startauftrag neu starten (neue Kennung); zählt als derselbe Abbruch.
# Gelingt auch das nicht, folgt failed: restart_session KEY GRUND
restart_session() {
  local key="$1" reason="$2"
  local msg ref role dir id out count
  msg="$(sed -n 1p "$RUN/$key.session")"
  ref="$(sed -n 2p "$RUN/$key.session")"
  role="$(sed -n 4p "$RUN/$key.session")"
  count="$(sed -n 6p "$RUN/$key.session")"
  dir="$WORK/$ref/$role"
  mkdir -p "$dir"
  id="$(new_id)"
  if out="$(launch "$key" "$dir" "$role" --session-id "$id" "$(start_prompt "$msg" "$role")")"; then
    set_line "$RUN/$key.session" 3 "$(date +%s)"
    set_line "$RUN/$key.session" 5 "$id"
    set_line "$RUN/$key.session" 7 0
    log "$ref: Sitzung $key neu gestartet ($reason), Kennung $id"
  else
    end_session "$key" "Die Sitzung ließ sich nach einem Abbruch nicht neu starten: $out Abbrüche derselben Meldung: $count, Art des letzten Abbruchs: Start fehlgeschlagen."
  fi
}

# Sitzung mit --resume im selben Arbeitsverzeichnis fortsetzen; geht das nicht, Neustart: resume_session KEY
resume_session() {
  local key="$1"
  local ref role dir id out
  ref="$(sed -n 2p "$RUN/$key.session")"
  role="$(sed -n 4p "$RUN/$key.session")"
  id="$(sed -n 5p "$RUN/$key.session")"
  dir="$WORK/$ref/$role"
  mkdir -p "$dir"
  if out="$(launch "$key" "$dir" "$role" --resume "$id" "$RESUME_PROMPT")"; then
    set_line "$RUN/$key.session" 3 "$(date +%s)"
    set_line "$RUN/$key.session" 7 "$(date +%s)"
    log "$ref: Sitzung $key fortgesetzt (Kennung $id)"
  else
    restart_session "$key" "Fortsetzung ließ sich nicht starten: $out"
  fi
}

# Abbruch: Zähler erhöhen und fortsetzen, nach dem ABORT_LIMIT-ten Abbruch derselben Meldung failed.
# abort_session KEY GRUND ART
abort_session() {
  local key="$1" reason="$2" kind="$3"
  local count
  count=$(( $(sed -n 6p "$RUN/$key.session") + 1 ))
  if (( count >= ABORT_LIMIT )); then
    end_session "$key" "$reason Abbrüche derselben Meldung: $count, Art des letzten Abbruchs: $kind."
    return
  fi
  tmux capture-pane -p -t "$key" -S -200 > "$RUN/$key.screen" 2>&1
  tmux kill-session -t "=$key" 2>/dev/null
  rm -f "$RUN/$key.heartbeat" "$RUN/$key.paused"
  set_line "$RUN/$key.session" 6 "$count"
  log "$(sed -n 2p "$RUN/$key.session"): Abbruch $count ($kind): $reason"
  resume_session "$key"
}

# Liegt in projectlead/ oder im Verzeichnis der anderen Rolle eine neue Meldung der gestarteten Rolle
# mit diesem ref? has_answer KEY REF ROLLE
has_answer() {
  local key="$1" ref="$2" role="$3"
  local c f
  while read -r c; do
    if grep -qxF "$c" "$RUN/$key.known"; then
      continue
    fi
    f="$MESSAGES/$c"
    if [[ "$(field "$f" from)" == "$role" && "$(field "$f" ref)" == "$ref" ]]; then
      return 0
    fi
  done < <(answer_candidates "$role")
  return 1
}

# Sekunden seit dem späteren Zeitpunkt von Start und letztem Herzschlag: silence KEY
silence() {
  local key="$1"
  local last
  last="$(sed -n 3p "$RUN/$key.session")"
  if [[ -e "$RUN/$key.heartbeat" && "$(stat -c %Y "$RUN/$key.heartbeat")" -gt "$last" ]]; then
    last="$(stat -c %Y "$RUN/$key.heartbeat")"
  fi
  echo $(( $(date +%s) - last ))
}

# ---------------------------------------------------------------- Pause wegen der Nutzungsgrenze

# Pausiert irgendeine Sitzung? Das Kontingent gilt für alle Sitzungen.
pause_active() {
  local p=("$RUN"/*.paused)
  (( ${#p[@]} > 0 ))
}

# Zeigt der sichtbare Inhalt der tmux-Sitzung die Meldung der Nutzungsgrenze? Zeile mit dem Suchtext auf stdout.
limit_line() {
  [[ -n "$LIMIT_TEXT" ]] || return 1
  tmux capture-pane -p -t "$1" 2>/dev/null | grep -F -m 1 -- "$LIMIT_TEXT"
}

# Sitzung als pausiert vermerken: pause_session KEY ZEILE
pause_session() {
  local key="$1" line="$2"
  local shown="" next
  shown="$(grep -oE -m 1 -- "$LIMIT_TIME_PATTERN" <<<"$line")"
  next=""
  if [[ -n "$shown" ]]; then
    next="$(date -d "$shown" +%s 2>/dev/null)"
  fi
  if [[ -z "$next" ]]; then
    shown=""
    next=$(( $(date +%s) + PAUSE_INTERVAL ))
  fi
  printf '%s\n%s\n' "$next" "$shown" >"$RUN/$key.paused"
  log "$(sed -n 2p "$RUN/$key.session"): Pause wegen der Nutzungsgrenze, nächste Prüfung ${shown:+ab $shown, sonst }um $(date -d "@$next" +%H:%M:%S)"
}

# Die Messung des Herzschlags beginnt für alle Sitzungen neu
reset_heartbeats() {
  local f
  for f in "$RUN"/*.session; do
    touch "$RUN/$(basename "$f" .session).heartbeat"
  done
}

# Pausierte Sitzungen, deren Prüfzeitpunkt erreicht ist, zum Fortfahren auffordern
resume_paused() {
  local f key
  for f in "$RUN"/*.paused; do
    key="$(basename "$f" .paused)"
    if [[ "$(date +%s)" -lt "$(sed -n 1p "$f")" ]]; then
      continue
    fi
    rm "$f"
    if [[ -f "$RUN/$key.session" ]]; then
      tmux send-keys -t "$key" -l "$CONTINUE_PROMPT"
      tmux send-keys -t "$key" Enter
      reset_heartbeats
      log "$(sed -n 2p "$RUN/$key.session"): Sitzung $key nach der Pause zum Fortfahren aufgefordert"
    fi
  done
}

check_session() {
  local key="$1"
  local ref role resumed
  ref="$(sed -n 2p "$RUN/$key.session")"
  role="$(sed -n 4p "$RUN/$key.session")"
  if has_answer "$key" "$ref" "$role"; then
    end_session "$key" ""
  elif ! tmux has-session -t "=$key" 2>/dev/null; then
    resumed="$(sed -n 7p "$RUN/$key.session")"
    if (( resumed > 0 && $(date +%s) - resumed < RESUME_GRACE )); then
      # die fortgesetzte Sitzung endete sofort: Fortsetzung nicht möglich, Neustart ohne neuen Abbruch
      restart_session "$key" "Fortsetzung nicht möglich"
    else
      abort_session "$key" "Die Sitzung besteht nicht mehr, ohne dass eine Antwortmeldung vorliegt." Absturz
    fi
  elif [[ -f "$RUN/$key.paused" ]]; then
    :
  elif [[ "$(silence "$key")" -ge "$HEARTBEAT_TIMEOUT" ]] && ! pause_active; then
    abort_session "$key" "Die Sitzung wurde beendet, weil $HEARTBEAT_TIMEOUT Sekunden lang kein Herzschlag kam." Stillstand
  fi
}

# Bei fehlendem Herzschlag vor jeder Entscheidung über einen Stillstand den Inhalt der tmux-Sitzungen lesen:
# Zeigt er die Nutzungsgrenze, gilt die Sitzung als pausiert (für alle Sitzungen, siehe check_session).
detect_pauses() {
  local f key line
  for f in "$RUN"/*.session; do
    key="$(basename "$f" .session)"
    if [[ ! -f "$RUN/$key.paused" ]] && tmux has-session -t "=$key" 2>/dev/null \
        && [[ "$(silence "$key")" -ge "$HEARTBEAT_TIMEOUT" ]] && line="$(limit_line "$key")"; then
      pause_session "$key" "$line"
    fi
  done
}

# ---------------------------------------------------------------- Bewertung

evaluate() {
  local f msg ref role
  detect_pauses
  for f in "$RUN"/*.session; do
    check_session "$(basename "$f" .session)"
  done
  resume_paused
  for role in "${ROLES[@]}"; do
    for f in "$MESSAGES/$role"/*.md; do
      msg="$(basename "$f")"
      if grep -qxF "$msg" "$STARTED"; then
        continue
      fi
      ref="$(field "$f" ref)"
      if ! valid_ref "$ref"; then
        echo "$msg" >>"$STARTED"
        queue_failed "$msg" "$ref" "$role" "Die Meldung enthält kein gültiges Feld ref; es wurde keine Sitzung gestartet."
        log "$msg: ungültiges ref „$ref“"
        continue
      fi
      # höchstens eine Sitzung je ref über beide Rollen; weitere Meldungen warten
      if [[ -f "$RUN/$(key_of "$ref").session" ]]; then
        continue
      fi
      start_session "$msg" "$ref" "$role"
    done
  done
  send_pending
}

# ---------------------------------------------------------------- Hauptschleife

waiter=""

stop() {
  if [[ -n "$waiter" ]]; then
    kill "$waiter" 2>/dev/null
  fi
  rm -f "$RUN/agentrun.pid"
  exit 0
}

main() {
  exec 8>"$RUN/agentrun.lock"
  if ! flock -n 8; then
    log "agentrun läuft bereits"
    exit 0
  fi
  echo "$$" >"$RUN/agentrun.pid"
  touch "$STARTED"
  trap stop TERM INT
  log "agentrun gestartet, PID $$, überwacht $MESSAGES"
  while true; do
    evaluate
    # Rückgabe 0: Änderung, 2: Zeitgrenze, 1: Fehler. Rekursiv über messages/, weil Git ein
    # Empfängerverzeichnis ohne Datei entfernt und mit der nächsten Meldung neu anlegt.
    inotifywait -q -r -t "$INTERVAL" -e create,close_write,moved_to,delete,moved_from \
      "$MESSAGES" >/dev/null 8>&- &
    waiter=$!
    wait "$waiter"
    if [[ $? -eq 1 ]]; then
      log "inotifywait fehlgeschlagen, agentrun endet"
      rm -f "$RUN/agentrun.pid"
      exit 1
    fi
    waiter=""
  done
}

main
