#!/usr/bin/env bash
# testenv – Testumgebung für die Steuerskripte unter tools/devhost/ (Entwicklungsverzeichnis im Kleinen).
#
# Aufruf:
#   testenv create VERZEICHNIS [Option …]   Testumgebung anlegen
#   testenv set VERZEICHNIS NAME WERT       einen Wert in den Kopien der Skripte einer Testumgebung ersetzen
#   testenv test [bats-Argument …]          alle Tests (tests/*.bats) ausführen, ohne Argument alle Dateien
#
# Die Werte der Skripte sind einfache Zuweisungen am Anfang des Skripts (NAME=wert oder NAME='wert', eine Zeile).
# Die Skripte lesen keinen Wert aus der Umgebung. create legt Kopien der Skripte an und ersetzt darin die Werte;
# set ersetzt einen weiteren Wert in den Kopien (in jedem der Skripte agentrun, pidcheck und startrole, das ihn enthält).
# Die Quellen unter tools/devhost/ bleiben unverändert.
#
# Optionen von create (ohne Option bleibt der Wert des Skripts):
#   --heartbeat-timeout SEKUNDEN   HEARTBEAT_TIMEOUT: Sekunden ohne Herzschlag bis zum Abbruch
#   --interval SEKUNDEN            INTERVAL: Prüfabstand von agentrun
#   --pause-interval SEKUNDEN      PAUSE_INTERVAL: Abstand der Prüfungen der Nutzungsgrenze ohne genannten Zeitpunkt
#   --pause-heartbeat-interval SEKUNDEN   PAUSE_HEARTBEAT_INTERVAL: Abstand der Aufrufe von heartbeat, während startrole wartet
#   --resume-grace SEKUNDEN        RESUME_GRACE: Endet eine fortgesetzte Sitzung innerhalb dieser Zeit, gilt die Fortsetzung als nicht möglich
#   --claude PROGRAMM              Programm der Sitzungen (tests/fakes/claude)
#   --tmux PROGRAMM                tmux (tests/fakes/tmux)
#   --gh PROGRAMM                  gh (tests/fakes/gh)
#   --scenario DATEI               Szenariendatei für das Ersatzprogramm claude (keine)
#   --github-repo NAME             Wert von GITHUB_REPO (testowner/testrepo)
#
# create legt unter VERZEICHNIS an: origin.git (lokales Git-Repository als origin), repo/ (Klon davon,
# Zweig main), run/, work/, devteam/ (bin/, lib/startrole, start.conf, settings.json), scripts/ (agentrun,
# heartbeat, pidcheck) und fakes/ (die Programme). In den Kopien ersetzt es immer CLAUDE (fakes/claude),
# GITHUB_REPO und den Suchpfad PATH in pidcheck (fakes/ vor dem üblichen Suchpfad). Tests, die tmux und gh
# als Namen aufrufen lassen, stellen fakes/ selbst vor ihren Suchpfad.

HERE="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
SRC="$(cd "$HERE/.." && pwd)"

die() {
  echo "testenv: $*" >&2
  exit 1
}

create() {
  local dir="" timeout="" interval="" pause="" pausehb="" grace="" claude="$HERE/fakes/claude" tmux="$HERE/fakes/tmux" gh="$HERE/fakes/gh"
  local scenario="" repo=testowner/testrepo
  while (( $# )); do
    case "$1" in
      --heartbeat-timeout) timeout="${2:?}"; shift 2 ;;
      --interval) interval="${2:?}"; shift 2 ;;
      --pause-interval) pause="${2:?}"; shift 2 ;;
      --pause-heartbeat-interval) pausehb="${2:?}"; shift 2 ;;
      --resume-grace)grace="${2:?}"; shift 2 ;;
      --claude) claude="${2:?}"; shift 2 ;;
      --tmux) tmux="${2:?}"; shift 2 ;;
      --gh) gh="${2:?}"; shift 2 ;;
      --scenario) scenario="${2:?}"; shift 2 ;;
      --github-repo) repo="${2:?}"; shift 2 ;;
      -*) die "unbekannte Option $1" ;;
      *) [[ -z "$dir" ]] || die "mehrere Verzeichnisse angegeben"; dir="$1"; shift ;;
    esac
  done
  [[ -n "$dir" ]] || die "Verzeichnis fehlt"
  local f
  for f in "$claude" "$tmux" "$gh"; do
    [[ -x "$f" ]] || die "$f ist nicht ausführbar"
  done
  [[ -z "$scenario" || -f "$scenario" ]] || die "Szenariendatei $scenario fehlt"

  mkdir -p "$dir"
  dir="$(cd "$dir" && pwd)"

  # origin und repo/
  local git=(git -c user.name=testenv -c user.email=testenv@example.invalid)
  "${git[@]}" init -q --bare -b main "$dir/origin.git"
  "${git[@]}" clone -q "$dir/origin.git" "$dir/repo" 2>/dev/null
  mkdir -p "$dir/repo/development/messages/architect" "$dir/repo/development/messages/projectlead"
  touch "$dir/repo/development/messages/architect/.gitkeep" "$dir/repo/development/messages/projectlead/.gitkeep"
  "${git[@]}" -C "$dir/repo" checkout -q -b main 2>/dev/null
  "${git[@]}" -C "$dir/repo" add development
  "${git[@]}" -C "$dir/repo" commit -q -m "Testumgebung"
  "${git[@]}" -C "$dir/repo" push -q -u origin main

  # Verzeichnisse und Skripte
  mkdir -p "$dir/run" "$dir/work" "$dir/scripts" "$dir/devteam/bin" "$dir/devteam/lib" "$dir/fakes"
  cp -p "$SRC/scripts/agentrun" "$SRC/scripts/heartbeat" "$SRC/scripts/pidcheck" "$dir/scripts/"
  cp -p "$SRC/devteam/lib/startrole" "$dir/devteam/lib/"

  # Ersatz für den Teil von devteam/, der nicht zu den Quellen gehört: Startskripte und Konfiguration
  local role
  for role in functiontest securitytest qa; do
    printf '#!/usr/bin/env bash\nMODEL=sonnet\nexec "${BASH_SOURCE[0]%%/*}/../lib/startrole" %s "$MODEL" "$@"\n' "$role" >"$dir/devteam/bin/$role"
    chmod +x "$dir/devteam/bin/$role"
  done
  cat >"$dir/devteam/start.conf" <<EOF
START_PROGRAM=($dir/fakes/claude --setting-sources project --permission-mode dontAsk
  --plugin-dir {devteam} --settings {devteam}/settings.json
  --agent devteam:{agent} --model {model} -p {prompt})
EOF
  echo '{}' >"$dir/devteam/settings.json"

  # Programme einhängen; ihre Daten liegen neben ihnen
  cp -p "$claude" "$dir/fakes/claude"
  cp -p "$tmux" "$dir/fakes/tmux"
  cp -p "$gh" "$dir/fakes/gh"
  if [[ -n "$scenario" ]]; then
    cp "$scenario" "$dir/fakes/claude.scenario"
  fi

  # Werte in den Kopien ersetzen
  set_value "$dir" CLAUDE "$dir/fakes/claude"
  set_value "$dir" GITHUB_REPO "$repo"
  set_value "$dir" PATH "$dir/fakes:/usr/local/bin:/usr/bin:/bin"
  [[ -z "$timeout" ]] || set_value "$dir" HEARTBEAT_TIMEOUT "$timeout"
  [[ -z "$interval" ]] || set_value "$dir" INTERVAL "$interval"
  [[ -z "$pause" ]] || set_value "$dir" PAUSE_INTERVAL "$pause"
  [[ -z "$pausehb" ]] || set_value "$dir" PAUSE_HEARTBEAT_INTERVAL "$pausehb"
  [[ -z "$grace" ]] || set_value "$dir" RESUME_GRACE "$grace"
}

# Wert NAME in den Kopien der Skripte einer Testumgebung ersetzen: set_value VERZEICHNIS NAME WERT
# Ersetzt die einfache Zuweisung „NAME=…“ am Zeilenanfang in jedem Skript, das sie enthält; Zahlen bleiben
# ohne Anführungszeichen, anderes steht in einfachen Anführungszeichen.
set_value() {
  local dir="$1" name="$2" value="$3" f repl n=0
  [[ -d "$dir/scripts" ]] || die "$dir ist keine Testumgebung"
  [[ "$name" =~ ^[A-Z_]+$ ]] || die "ungültiger Name $name"
  case "$value" in
    *\'* | *$'\n'*) die "Wert für $name darf weder ' noch einen Zeilenumbruch enthalten" ;;
  esac
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    repl="$value"
  else
    repl="'$value'"
  fi
  repl="$(printf '%s' "$repl" | sed 's/[\\&|]/\\&/g')"
  for f in "$dir/scripts/agentrun" "$dir/scripts/pidcheck" "$dir/devteam/lib/startrole"; do
    if grep -q "^$name=" "$f"; then
      sed -i "s|^$name=.*|$name=$repl|" "$f"
      n=$((n + 1))
    fi
  done
  (( n > 0 )) || die "kein Skript enthält die Zuweisung $name="
}

run_tests() {
  command -v bats >/dev/null || die "bats ist nicht verfügbar"
  if (( $# )); then
    bats "$@"
  else
    bats "$HERE"/*.bats
  fi
}

case "${1:-}" in
  create) shift; create "$@" ;;
  set) [[ $# -eq 4 ]] || die "Aufruf: testenv set VERZEICHNIS NAME WERT"; set_value "$2" "$3" "$4" ;;
  test) shift; run_tests "$@" ;;
  *) die "Aufruf: testenv create VERZEICHNIS [Option …] | testenv set VERZEICHNIS NAME WERT | testenv test [bats-Argument …]" ;;
esac
