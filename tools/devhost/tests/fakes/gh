#!/usr/bin/env bash
# Testattrappe für „gh api“ mit der Schnittstelle für Dateiinhalte.
# Dateien liegen neben ihr unter github/<owner>/<name>/<pfad>.
# Liegt daneben gh.fail, schlägt jeder Aufruf fehl.
dir="$(dirname "$0")"
if [[ -f "$dir/gh.fail" ]]; then
  echo "HTTP 502" >&2
  exit 1
fi
shift
method=GET
path=""
declare -A f=()
while (( $# )); do
  case "$1" in
    -X) method="$2"; shift 2 ;;
    -f) f["${2%%=*}"]="${2#*=}"; shift 2 ;;
    *) path="$1"; shift ;;
  esac
done
[[ "$path" =~ ^repos/([^/]+/[^/]+)/contents/(.+)$ ]] || exit 2
file="$dir/github/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
if [[ "$method" != PUT ]]; then
  exit 2
fi
if [[ -f "$file" ]]; then
  echo "HTTP 422: sha wasn't supplied" >&2
  exit 1
fi
mkdir -p "$(dirname "$file")"
printf '%s' "${f[content]}" | base64 -d >"$file"
echo "branch=${f[branch]}" >"$file.meta"
echo '{}'
